# =============================================================
#  Date to Go – Backend Environment Variables
#  Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================

# ── Server ─────────────────────────────────────────────────
BASE_DOMAIN=https://trendgateway.com
PORT=5000
NODE_ENV=production
API_VERSION=v1

# ── MongoDB ────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/date-to-go-dev

# ── JWT ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_64_chars_minimum
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_64_chars_minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# ── Cookie ─────────────────────────────────────────────────
COOKIE_DOMAIN=localhost

# ── Rate Limits ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug

# ── App ────────────────────────────────────────────────────
APP_NAME=Date to Go
APP_URL=http://localhost:5173

# ── Seed Script ─────────────────────────────────────────────────────────────
# Used by `npm run seed` to create the initial ADMIN user.
# Must be set in .env before running the seed script.
ADMIN_EMAIL=admin@date-to-go.in
ADMIN_PASSWORD=CHANGE_ME_strong_password_12chars_min
